{
  "name": "@amnesia2k/git-aic",
  "type": "module",
  "version": "2.1.12",
  "description": "AI-generated Conventional Commit messages and diff reports for Git, powered by Google Gemini",
  "main": "dist/bin/cli.js",
  "bin": {
    "git-aic": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/",
    "src/",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "tsx bin/cli.ts",
    "commit": "tsx bin/cli.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build",
    "release": "npm version patch && git push origin master --follow-tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnesia2k/git-aic.git"
  },
  "bugs": {
    "url": "https://github.com/amnesia2k/git-aic/issues"
  },
  "homepage": "https://github.com/amnesia2k/git-aic#readme",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "keywords": [
    "git",
    "aic",
    "ai",
    "git-aic",
    "gemini",
    "google-gemini",
    "llm",
    "conventional-commits",
    "commit-generator",
    "diff-explanations",
    "productivity",
    "cli",
    "typescript"
  ],
  "author": {
    "name": "Olatilewa Olatoye",
    "email": "tilewaolatoye17@gmail.com",
    "url": "https://github.com/amnesia2k"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "cli-loaders": "^3.0.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "simple-git": "^3.32.3"
  }
}
